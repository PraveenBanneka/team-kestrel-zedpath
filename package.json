{
  "name": "zedpath",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "ZedPath: every path a Sri Lankan student can reach after A/L results. React + Hono on Cloudflare Workers.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "npm run build && vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "rulebook": "node tools/rulebook/build-rulebook.ts",
    "validate:schema": "node tools/seed/validate-schema.ts",
    "cf-typegen": "wrangler types",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "hono": "^4.13.13",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.62.5",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.147.0"
  }
}
