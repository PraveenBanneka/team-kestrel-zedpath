{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zedpath",
  // LOCKED to the ZedPath Cloudflare account (Stacklineops@gmail.com's Account).
  // Wrangler has one login for the whole laptop; this pin is what stops a deploy landing on another account.
  // Any tool that regenerates this file (e.g. a scaffold) MUST keep this line. The guard also checks it.
  "account_id": "e6474e41044c5722ad57c3372ab7492e",
  "compatibility_date": "2026-09-01",
  // Hono API Worker. Only /api/* runs the Worker; every other path is a static asset (free, unlimited)
  // and unknown paths fall back to the React SPA's index.html (ZP-DOC-06, ADR-001; NFR-012).
  "main": "./worker/index.ts",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true },
  // Student accounts (CR-001). database_id is a placeholder until Praveen's GO for `d1 create`: local dev works on a
  // local copy, and a deploy fails on the placeholder, so accounts cannot go live before the real database exists.
  "d1_databases": [
    { "binding": "DB", "database_name": "zedpath", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }
  ],
  // Free Workers Rate Limiting: slows password guessing (per IP + username) and sign-up floods (per IP).
  "ratelimits": [
    { "name": "AUTH_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }
  ]
}
