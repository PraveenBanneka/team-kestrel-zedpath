{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zedpath",
  // LOCKED to the ZedPath Cloudflare account (Stacklineops@gmail.com's Account).
  // Wrangler has one login for the whole laptop; this pin is what stops a deploy landing on another account.
  // Any tool that regenerates this file (e.g. a scaffold) MUST keep this line. The guard also checks it.
  "account_id": "e6474e41044c5722ad57c3372ab7492e",
  "compatibility_date": "2026-09-01",
  // Hono API Worker. Only /api/* runs the Worker; every other path is a static asset (free, unlimited)
  // and unknown paths fall back to the React SPA's index.html (ZP-DOC-06, ADR-001; NFR-012).
  "main": "./worker/index.ts",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true },
  // Student accounts (CR-001). D1 database `zedpath`, created 2026-10-05 (APAC) after Praveen's GO.
  "d1_databases": [
    { "binding": "DB", "database_name": "zedpath", "database_id": "59e854ed-cf1b-4e32-8682-386b53a1e8ae", "migrations_dir": "migrations" }
  ],
  // Ask ZedPath. Workers AI (free 10k neurons/day): bge-m3 embeddings, multilingual. Vectorize index `zedpath-ask`
  // (created at Praveen's GO; until then a deploy fails, so Ask cannot ship half-built). remote: local dev uses the
  // real index, as Vectorize has no local simulation.
  "ai": { "binding": "AI" },
  "vectorize": [
    { "binding": "ASK_INDEX", "index_name": "zedpath-ask", "remote": true }
  ],
  // Free Workers Rate Limiting. AUTH_LIMITER: 10/min per IP + username (slows guessing one account's password).
  // IP_LIMITER: 100/min per IP overall (stops floods, yet a school lab or a home Wi-Fi sharing one IP still fits).
  "ratelimits": [
    { "name": "AUTH_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "IP_LIMITER", "namespace_id": "1002", "simple": { "limit": 100, "period": 60 } }
  ]
}
